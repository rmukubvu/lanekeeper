{
  "name": "lanekeeper",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic change management for GitHub: PR triage and routing, policy lanes, guided walkthroughs of large diffs, and chat notifications (Teams, Slack, Discord)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "server": "tsx src/server.ts",
    "triage": "tsx src/cli.ts",
    "dashboard": "tsx src/dashboard-server.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "npm --prefix web run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "sentinel": "tsx src/sentinel-cli.ts",
    "docs": "npm --prefix docs run dev",
    "build:docs": "npm --prefix docs run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "minimatch": "^10.2.6",
    "octokit": "^5.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
