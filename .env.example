# --- LLM provider ---
# LANEKEEPER_PROVIDER=anthropic          # anthropic (default) | openrouter | openai-compatible
# LANEKEEPER_MODEL=claude-opus-5         # provider-specific default applied when unset
# LANEKEEPER_MAX_OUTPUT_TOKENS=8192      # cap for openrouter/openai-compatible responses

# anthropic (default): best quality + server-validated structured outputs
# ANTHROPIC_API_KEY=sk-ant-...           # or authenticate once with `ant auth login`

# openrouter: one key, many models (model names are vendor-prefixed)
# OPENROUTER_API_KEY=sk-or-...
# LANEKEEPER_MODEL=anthropic/claude-opus-5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# openai-compatible: local models (Ollama, LM Studio, vLLM) or an enterprise gateway
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=                 # usually not needed locally
# LANEKEEPER_MODEL=qwen3:32b

# --- GitHub: one-off CLI mode (npm run triage) ---
# GITHUB_TOKEN=ghp_...                  # PAT with repo scope
# GITHUB_API_URL=https://github.example.com/api/v3   # only for GitHub Enterprise Server

# --- GitHub: App/server mode (npm run server) ---
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_PATH=./lanekeeper.private-key.pem
# GITHUB_WEBHOOK_SECRET=change-me
# PORT=3000

# --- Dashboard ---
# DASHBOARD_PORT=4400                    # standalone dashboard (npm run dashboard / demo)
# LANEKEEPER_DATA_DIR=.lanekeeper        # where triage events are recorded (JSONL)

# --- Chat adapters (enable any subset; each is just an incoming-webhook URL) ---
# TEAMS_WEBHOOK_URL=...    # Teams "Workflows" (Power Automate) webhook that posts Adaptive Cards to a channel
# SLACK_WEBHOOK_URL=...    # Slack incoming webhook
# DISCORD_WEBHOOK_URL=...  # Discord channel webhook
